# Copy to .env.local and fill in from your own Supabase project:
#   Dashboard -> Settings -> API Keys -> Publishable key
#
# Both values are public by design. The publishable key is safe to ship in the
# browser bundle *because* row level security is enabled and forced on every
# table — RLS protects the data, not the secrecy of this key.
#
# Never add a secret / service_role key here. It bypasses RLS entirely.

VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."
