        {
          "muscle": "upperChest",
          "fraction": 1
        },
        {
          "muscle": "chest",
          "fraction": 1
        },
        {
          "muscle": "frontDelts",
          "fraction": 0.5
        },
        {
          "muscle": "triceps",
          "fraction": 0.5
        }
