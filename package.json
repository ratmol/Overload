{
  "name": "overload",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @overload/web",
    "build": "npm run build --workspace @overload/web",
    "preview": "npm run preview --workspace @overload/web",
    "test": "npm run test --workspace @overload/engine && npm run test --workspace @overload/web",
    "typecheck": "tsc --noEmit -p packages/engine/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.7"
  }
}
